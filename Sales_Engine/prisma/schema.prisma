generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

enum LeadStatus {
  PENDING
  SCRAPED
  PERSONALIZED
  SYNCED
}

enum BusinessType {
  HOTEL
  RESORT
  RESTAURANT
  SERVICE_APARTMENT
  CONSULTANT
  EVENT_PLANNER
  TRAINING_INSTITUTE
  OTHER
}

enum Classification {
  DIRECT_CUSTOMER
  CHANNEL_PARTNER
}

enum DecisionMakerTier {
  TIER_1
  TIER_2
  TIER_3
}

model Lead {
  id                    Int                @id @default(autoincrement())
  name                  String
  hotelName             String?
  brandType             String?
  propertySizeCategory  String?
  company               String?
  website               String
  email                 String
  jobTitle              String?
  phone                 String?
  linkedinUrl           String?
  location              String?
  city                  String?
  state                 String?
  exactAddress          String?
  googleMapsLink        String?
  industry              String?
  project               String?
  source                String?
  googleBusinessLink    String?
  tripAdvisorLink       String?
  bookingComLink         String?
  makeMyTripLink         String?
  instagramLink         String?
  facebookLink           String?
  googleRating          Float?
  totalReviewsCount     Int?
  sentimentScore        Float?
  hubspotContactId      String?
  hubspotCompanyId      String?
  hubspotSyncStatus     String?
  hubspotSyncedAt       DateTime?
  hubspotSyncError      String?
  latitude              Float?
  longitude             Float?
  scrapedContext        String?
  icebreaker            String?
  status                LeadStatus         @default(PENDING)
  
  // Scoring fields
  businessType          BusinessType?
  classification        Classification?
  decisionMakerTier     DecisionMakerTier?
  relevanceScore        Int                @default(0)
  intentScore           Int                @default(0)
  buyingPowerScore      Int                @default(0)
  intentSignals         String?            // JSON stringified array
  
  createdAt             DateTime           @default(now())
  updatedAt             DateTime           @updatedAt

  @@index([status])
  @@index([relevanceScore])
  @@index([decisionMakerTier])
  @@unique([email, website])
}