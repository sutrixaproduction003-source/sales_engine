# Copy to .env.local and fill in your keys (also editable via the Settings page).
# Leads are stored in an Excel workbook (default: data/leads.xlsx).
# LEADS_XLSX_PATH="C:/Users/you/Documents/leads.xlsx"

# Sign-in: every page and API route asks for this password when it is set.
# Required when deployed (on Vercel the app refuses to run without it).
APP_PASSWORD=""
# Where the backend (backendZip) runs, and the shared key it expects.
LEAD_BACKEND_URL="http://localhost:5000"
BACKEND_API_KEY=""

# Runtime secrets
APIFY_TOKEN=""
OMNIROUTE_API_KEY=""
OMNIROUTE_BASE_URL="https://api.omniroute.ai/v1"
OMNIROUTE_MODEL="claude-3-5-haiku"
DEEPSEEK_API_KEY="your_deepseek_api_key_here"
DEEPSEEK_BASE_URL="https://api.deepseek.com"
DEEPSEEK_MODEL="deepseek-chat"
INSTANTLY_API_KEY=""
INSTANTLY_BASE_URL="https://app.instantly.ai/api/v1"
