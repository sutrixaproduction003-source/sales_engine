# Required when the backend is on the public internet: only callers sending
# this key (the Sales Engine app, its BACKEND_API_KEY) can use the API.
BACKEND_API_KEY=
APOLLO_API_KEY=
APIFY_TOKEN=
# Visit business websites for emails during Google Maps scrapes (extra Apify credits)
APIFY_SCRAPE_CONTACTS=true
PORT=5000
# Optional: where the file-backed lead store lives (default: ./data)
LEADS_DATA_DIR=
