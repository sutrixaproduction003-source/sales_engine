{
  "info": {
    "name": "CRM Lead Enrichment Backend",
    "schema": "https://schema.getpostman.com/json/collection/v2.1.0/collection.json"
  },
  "variable": [
    {
      "key": "BASE_URL",
      "value": "http://localhost:5000/api",
      "type": "string"
    }
  ],
  "item": [
    {
      "name": "Health",
      "request": {
        "method": "GET",
        "header": [],
        "url": "{{BASE_URL}}/crm/health"
      }
    },
    {
      "name": "Search people",
      "request": {
        "method": "POST",
        "header": [{ "key": "Content-Type", "value": "application/json" }],
        "body": {
          "mode": "raw",
          "raw": "{\n  \"provider\": \"prospeo\",\n  \"filters\": {\n    \"job_title\": \"CEO\"\n  },\n  \"page\": 1\n}"
        },
        "url": "{{BASE_URL}}/leads/search"
      }
    },
    {
      "name": "Search companies",
      "request": {
        "method": "POST",
        "header": [{ "key": "Content-Type", "value": "application/json" }],
        "body": {
          "mode": "raw",
          "raw": "{\n  \"provider\": \"prospeo\",\n  \"filters\": {\n    \"industry\": \"Software\"\n  },\n  \"page\": 1\n}"
        },
        "url": "{{BASE_URL}}/companies/search"
      }
    },
    {
      "name": "Enrich person",
      "request": {
        "method": "POST",
        "header": [{ "key": "Content-Type", "value": "application/json" }],
        "body": {
          "mode": "raw",
          "raw": "{\n  \"provider\": \"prospeo\",\n  \"firstName\": \"John\",\n  \"lastName\": \"Doe\",\n  \"companyWebsite\": \"example.com\"\n}"
        },
        "url": "{{BASE_URL}}/leads/enrich"
      }
    },
    {
      "name": "Enrich company",
      "request": {
        "method": "POST",
        "header": [{ "key": "Content-Type", "value": "application/json" }],
        "body": {
          "mode": "raw",
          "raw": "{\n  \"provider\": \"prospeo\",\n  \"companyWebsite\": \"example.com\"\n}"
        },
        "url": "{{BASE_URL}}/companies/enrich"
      }
    },
    {
      "name": "Email finder",
      "request": {
        "method": "POST",
        "header": [{ "key": "Content-Type", "value": "application/json" }],
        "body": {
          "mode": "raw",
          "raw": "{\n  \"provider\": \"hunter\",\n  \"firstName\": \"John\",\n  \"lastName\": \"Doe\",\n  \"domain\": \"example.com\"\n}"
        },
        "url": "{{BASE_URL}}/leads/email-finder"
      }
    },
    {
      "name": "Email verification",
      "request": {
        "method": "POST",
        "header": [{ "key": "Content-Type", "value": "application/json" }],
        "body": {
          "mode": "raw",
          "raw": "{\n  \"provider\": \"hunter\",\n  \"email\": \"john@example.com\"\n}"
        },
        "url": "{{BASE_URL}}/leads/email-verify"
      }
    },
    {
      "name": "Lead status update",
      "request": {
        "method": "PATCH",
        "header": [{ "key": "Content-Type", "value": "application/json" }],
        "body": {
          "mode": "raw",
          "raw": "{\n  \"status\": \"QUALIFIED\"\n}"
        },
        "url": "{{BASE_URL}}/leads/1/status"
      }
    }
  ]
}
